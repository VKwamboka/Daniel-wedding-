# ─── Supabase (photo gallery storage + RSVP database) ───────────────────────
# Create a free project at https://supabase.com, run supabase/setup.sql in the
# SQL editor, then copy these two values from Project Settings → API.
# Without them the site runs in "demo mode" (data stays in the visitor's browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Name of the public storage bucket created by setup.sql
VITE_SUPABASE_BUCKET=wedding-photos

# The public address of the deployed site, e.g. https://henry-and-diana.netlify.app
# Used to build the gallery links and QR codes. Leave empty to use the current address.
VITE_SITE_URL=
